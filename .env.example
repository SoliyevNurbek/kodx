# kodx.uz sozlamalari — nusxa oling: cp .env.example .env
# va qiymatlarni to'ldiring. .env hech qachon commit qilinmaydi.

# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL 8 (utf8mb4). OpenServer 6 da host odatda 127.0.1.x bo'ladi.
DB_NAME=kodx
DB_USER=kodx_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Judge: "local" — faqat DEBUG (production uchun EMAS), "judge0" — production
JUDGE_BACKEND=local
JUDGE0_URL=
JUDGE0_TOKEN=
JUDGE0_AUTH_HEADER=X-Auth-Token

# Xavfsizlik (production: config.settings_prod)
KODX_REQUIRE_SUPERADMIN_2FA=True
CSP_ENABLED=True
PROD_ALLOWED_HOSTS=kodx.uz,www.kodx.uz
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
